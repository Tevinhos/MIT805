# SET UP
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Converting parquet to CSV
parquet_path = r"C:\Users\TevezCebekulu\Downloads\fhvhv_tripdata_2025-07.parquet"
csv_path = r"C:\Users\TevezCebekulu\Downloads\fhvhv_tripdata_2025-07.csv"

# Read the Parquet file
df = pd.read_parquet(parquet_path)

# Save to CSV
df.to_csv(csv_path, index=False)

print("Conversion completed: CSV saved at", csv_path)

# Appending all the CSVs

folder_path = r"C:\Users\TevezCebekulu\Downloads"

months = ['01', '02', '03', '04', '05', '06', '07']
file_list = [f"fhvhv_tripdata_2025-{month}.csv" for month in months]

combined_df = pd.concat(
    [pd.read_csv(os.path.join(folder_path, file)) for file in file_list],
    ignore_index=True
)

output_path = os.path.join(folder_path, "fhvhv_tripdata_2025-Jan_to_Jul.csv")
combined_df.to_csv(output_path, index=False)

print(f" Combined CSV saved to: {output_path}")
